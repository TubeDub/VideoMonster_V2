[
  {
    "start": 0.59,
    "end": 2.59,
    "text": "我们陆家八代单传",
    "uk": "У родині Лу вісім поколінь — один спадкоємець."
  },
  {
    "start": 2.59,
    "end": 3.59,
    "text": "子嗣难保",
    "uk": "Рід ледь тримається."
  },
  {
    "start": 3.59,
    "end": 4.59,
    "text": "如今啊",
    "uk": "А тепер…"
  },
  {
    "start": 4.59,
    "end": 5.59,
    "text": "你怀孕了",
    "uk": "Ти вагітна."
  },
  {
    "start": 5.59,
    "end": 7.59,
    "text": "陆家有后了",
    "uk": "У Лу нарешті є спадкоємець."
  },
  {
    "start": 7.59,
    "end": 9.59,
    "text": "要是能一举得男",
    "uk": "Якби ще народився хлопчик —"
  },
  {
    "start": 9.59,
    "end": 11.59,
    "text": "那就更完美了",
    "uk": "було б ідеально."
  },
  {
    "start": 11.59,
    "end": 14.03,
    "text": "妈",
    "uk": "Мамо."
  },
  {
    "start": 14.03,
    "end": 15.03,
    "text": "这是我一生的",
    "uk": "Це на все моє життя."
  },
  {
    "start": 15.03,
    "end": 17.03,
    "text": "无论是男是女",
    "uk": "Хоч хлопчик, хоч дівчинка —"
  },
  {
    "start": 17.03,
    "end": 18.03,
    "text": "我都喜欢",
    "uk": "я любитиму."
  },
  {
    "start": 18.03,
    "end": 34.68,
    "text": "喜欢哥哥",
    "uk": "Люблю братика."
  },
  {
    "start": 34.68,
    "end": 36.68,
    "text": "我怀孕了",
    "uk": "Я вагітна."
  },
  {
    "start": 36.68,
    "end": 40.88,
    "text": "是一个月之前的一场意外",
    "uk": "Це через випадок місяць тому."
  },
  {
    "start": 40.96,
    "end": 41.96,
    "text": "一个月前",
    "uk": "Місяць тому"
  },
  {
    "start": 41.96,
    "end": 43.96,
    "text": "我和曲妃妃同时被绑架",
    "uk": "мене й Цюй Фейфей викрали разом."
  },
  {
    "start": 43.96,
    "end": 45.96,
    "text": "那晚她迎合绑匪",
    "uk": "Тієї ночі вона піддалась викрадачеві."
  },
  {
    "start": 45.96,
    "end": 46.96,
    "text": "所以",
    "uk": "Тому"
  },
  {
    "start": 46.96,
    "end": 48.96,
    "text": "这个孩子是绑匪的",
    "uk": "ця дитина — від викрадача."
  },
  {
    "start": 48.96,
    "end": 62.48,
    "text": "一个月之前的意外",
    "uk": "Той випадок місяць тому."
  },
  {
    "start": 62.48,
    "end": 64.48,
    "text": "是那个绑架",
    "uk": "То було те викрадення."
  },
  {
    "start": 64.48,
    "end": 66.98,
    "text": "这孩子是绑匪的",
    "uk": "Ця дитина — від викрадача."
  }
]