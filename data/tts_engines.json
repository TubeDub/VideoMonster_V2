{
  "version": 1,
  "engines": [
    {
      "id": "edge-offline",
      "name": "Edge Neural (локальный)",
      "provider": "Microsoft Edge TTS",
      "description": "Бесплатный нейро-голос через edge-tts. Работает офлайн после установки пакета. Default fallback (Ostap).",
      "mode": "offline"
    },
    {
      "id": "tts_uk",
      "name": "tts_uk (RAD-TTS++ / Vocos)",
      "provider": "tts_uk",
      "description": "Рекомендований український TTS: pip install tts-uk. Голоси lada / tetiana / mykyta. Контроль duration (token_dur_scaling).",
      "mode": "offline",
      "config_keys": ["VM_TTS_UK_OUT_SR"]
    },
    {
      "id": "piper",
      "name": "Piper TTS (uk_UA-*-high)",
      "provider": "Piper",
      "description": "Швидкий локальний TTS. Моделі uk_UA-*-high; PIPER_MODEL / PIPER_MODELS_DIR. length_scale підтримується.",
      "mode": "offline",
      "config_keys": ["PIPER_MODEL", "VM_PIPER_MODEL", "PIPER_MODELS_DIR", "VM_PIPER_MODELS_DIR"]
    },
    {
      "id": "coqui",
      "name": "Coqui / XTTS",
      "provider": "Coqui TTS",
      "description": "Локальный Coqui TTS; XTTS клонирует голос по reference WAV (VM_COQUI_SPEAKER_WAV / clone API).",
      "mode": "offline",
      "config_keys": ["VM_COQUI_MODEL", "VM_COQUI_SPEAKER_WAV", "VM_COQUI_LANG"]
    },
    {
      "id": "online-studio",
      "name": "Online Studio",
      "provider": "VideoMonster Cloud",
      "description": "HTTP-мост к VM_STUDIO_TTS_URL (/synthesize).",
      "mode": "online",
      "config_keys": ["VM_STUDIO_TTS_URL", "VM_STUDIO_TTS_TOKEN"]
    },
    {
      "id": "openai-voice",
      "name": "OpenAI Voice",
      "provider": "OpenAI",
      "description": "GPT-4o mini TTS — нужен OPENAI_API_KEY.",
      "mode": "online",
      "config_keys": ["OPENAI_API_KEY", "VM_OPENAI_TTS_MODEL", "VM_OPENAI_TTS_VOICE"]
    },
    {
      "id": "elevenlabs",
      "name": "ElevenLabs",
      "provider": "ElevenLabs",
      "description": "Премиальные голоса — нужен ELEVENLABS_API_KEY.",
      "mode": "online",
      "config_keys": ["ELEVENLABS_API_KEY", "ELEVENLABS_VOICE_ID"]
    },
    {
      "id": "azure-neural",
      "name": "Azure Neural",
      "provider": "Microsoft Azure",
      "description": "Azure Cognitive Services Neural TTS — AZURE_SPEECH_KEY + REGION.",
      "mode": "online",
      "config_keys": ["AZURE_SPEECH_KEY", "AZURE_SPEECH_REGION"]
    },
    {
      "id": "google-neural",
      "name": "Google Neural",
      "provider": "Google Cloud",
      "description": "Google Cloud Text-to-Speech — GOOGLE_TTS_KEY / GOOGLE_API_KEY.",
      "mode": "online",
      "config_keys": ["GOOGLE_TTS_KEY"]
    }
  ]
}
