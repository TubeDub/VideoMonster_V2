        "voice_verification_retry_count": 3,
        "voice_verification_asr_text": "Джордж Молодший був дуже розумною дитину, але також і віенд дуже легко відволікався.\nІ через цивіен справді не займався чимось серьезним, окремав тому білів саме в цей момент.",
        "voice_verification_route_to": "semantic"
      },
