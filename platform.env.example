# TubeDub AI Media Platform — enable all modules (dev / owner)
VM_PLATFORM_ENABLED=1
VM_PLATFORM_DIAGNOSTICS=1

# Live Translation (Etap 1)
VM_LIVE_TRANSLATION_ENABLED=1
VM_LIVE_STT_MODEL=tiny
VM_LIVE_CHUNK_SECONDS=4
VM_LIVE_SUBTITLES=1
# VM_LIVE_SIMULATE_ONLY=1

# Streaming Studio (Etap 2)
VM_STREAMING_STUDIO_ENABLED=1
# VM_STREAMING_RTMP_URL=rtmp://127.0.0.1/live/stream

# AI Live Dub (Etap 3)
VM_AI_LIVE_DUB_ENABLED=1

# Media Browser (Etap 4)
VM_MEDIA_BROWSER_ENABLED=1

# Recording Studio (Etap 5)
VM_RECORDING_STUDIO_ENABLED=1

# Voice / Vocal Training (Etap 6–7)
VM_VOICE_TRAINING_ENABLED=1
VM_VOCAL_TRAINING_ENABLED=1

# AI Assistant (Etap 9)
VM_AI_ASSISTANT_ENABLED=1

# Optional external tools (install separately):
# pip install yt-dlp noisereduce pedalboard librosa

# ── Cloud OAuth (remote sync; local mirrors work without these) ──
# Without secrets, remote OAuth is hard-gated — never reports "connected".
# VM_GOOGLE_CLIENT_ID=
# VM_GOOGLE_CLIENT_SECRET=
# VM_GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/api/cloud/oauth/google_drive/callback
# VM_ONEDRIVE_CLIENT_ID=
# VM_ONEDRIVE_CLIENT_SECRET=
# VM_ONEDRIVE_REDIRECT_URI=http://127.0.0.1:5000/api/cloud/oauth/onedrive/callback
# VM_DROPBOX_APP_KEY=
# VM_DROPBOX_APP_SECRET=
# VM_DROPBOX_REDIRECT_URI=http://127.0.0.1:5000/api/cloud/oauth/dropbox/callback
# VM_CLOUD_PLATFORM_ENABLED=1
# VM_STREAMING_RTMP_URL=rtmp://127.0.0.1/live/stream
