# TubeDub / VideoMonster V2 — environment template
# Copy to .env and adjust (never commit .env)

# ── Core ─────────────────────────────────────────────
# VM_DEV_MODE=1
# VM_DEVELOPER_MODE=1
# VM_WHISPER_DEVICE=cpu
# VM_FAST_START=1
# VM_PREPARE_WARMUP=0

# ── License (owner / server) ───────────────────────
# VM_LICENSE_SECRET=change-me-in-production
# VM_LICENSE_SERVER_URL=

# ── LLM / naturalizer (optional) ───────────────────
# OPENAI_API_KEY=
# VM_LLM_API_KEY=
# VM_LLM_BASE_URL=

# ── Feature flags (override JSON defaults) ─────────
# VM_DUB_STUDIO_ENABLED=1
# VM_CLOUD_PLATFORM_ENABLED=1
# VM_FEATURE_DEVELOPER_TOOLS=1

# ── Translation dev paths ──────────────────────────
# VM_USE_ROUTER=0
# MT_CHALLENGE_MODE=0

# ── Cloud (see also platform.env.example) ──────────
# VM_S3_BUCKET=
# VM_S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Platform modules: copy platform.env.example → platform.env
