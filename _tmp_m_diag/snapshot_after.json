    },
    "actual_start_ms": 44400,
    "actual_end_ms": 55488,
    "slot_ms": 12160
  },
  {
    "index": 6,
    "text": "Через два тижні Джордж-молодший лежав у лікарняному ліжку у відділенні інтенсивної терапії місцевої лікарні.",
    "file": "94502c62_seg0000.mp3",
    "start_ms": 56720,
    "end_ms": 62320,
    "allow_atempo": false,
    "place_delay_ms": 0,
    "lead_in_ms": 0,
    "fitted_file": "slot_6_7478da96_fit.wav",
    "tts_ms": 8160,
    "overflow_pct": 26.0,
