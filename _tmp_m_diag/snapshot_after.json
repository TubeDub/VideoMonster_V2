    },
    "actual_start_ms": 84720,
    "actual_end_ms": 100416,
    "slot_ms": 12560
  },
  {
    "index": 11,
    "text": "А замість того, як він підбирав цю камеру і дійсно потрапив до свого старого хобі фотографії.",
    "file": "dbe975fd_seg0000.mp3",
    "start_ms": 97280,
    "end_ms": 102560,
    "allow_atempo": false,
    "place_delay_ms": 0,
